# Copy to .env and replace placeholders. Do not commit .env.
# Values are local/synthetic only. This application must not use real credentials.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL (Compose interpolates POSTGRES_* ; the API uses DATABASE_URL)
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DBNAME
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DBNAME

MOCK_INTEGRATION_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://127.0.0.1:3000

# CI and default local demos use fake providers. Set ollama only for an optional local model.
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434

SOTEOPS_SEED_FILE=seed/identities.json

# Local demo authentication only. Not Entra ID or any production identity provider.
# Leave DEMO_AUTH_ENABLED=false unless ENVIRONMENT is local, test, ci, or demo.
DEMO_AUTH_ENABLED=true
SESSION_SECRET=CHANGE_ME_LOCAL_SESSION_SECRET
COOKIE_SECURE=false
POLICY_FILE=seed/policy/v1.json
